<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23501" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="launch-controller">
    <device id="retina6_12" orientation="portrait" appearance="dark"/>
    <dependencies><plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23501"/><capability name="Safe area layout guides" minToolsVersion="9.0"/><capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/></dependencies>
    <scenes><scene sceneID="launch-scene"><objects>
        <viewController id="launch-controller" sceneMemberID="viewController"><view key="view" contentMode="scaleToFill" id="launch-view">
            <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" alignment="center" spacing="18" translatesAutoresizingMaskIntoConstraints="NO" id="brand-stack">
                    <rect key="frame" x="116.5" y="371" width="160" height="110"/>
                    <subviews>
                        <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" image="car.side.fill" catalog="system" translatesAutoresizingMaskIntoConstraints="NO" id="brand-car">
                            <rect key="frame" x="53" y="0.0" width="54" height="30"/>
                            <color key="tintColor" red="0.69" green="0.94" blue="0.81" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                            <constraints><constraint firstAttribute="width" constant="54" id="car-width"/><constraint firstAttribute="height" constant="30" id="car-height"/></constraints>
                        </imageView>
                        <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="MileLog" textAlignment="center" numberOfLines="1" adjustsFontForContentSizeCategory="YES" translatesAutoresizingMaskIntoConstraints="NO" id="brand-name">
                            <rect key="frame" x="18" y="48" width="124" height="40"/>
                            <fontDescription key="fontDescription" type="boldSystem" pointSize="34"/>
                            <color key="textColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                        </label>
                        <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="brand-route">
                            <rect key="frame" x="0.0" y="106" width="160" height="4"/>
                            <color key="backgroundColor" red="0.69" green="0.94" blue="0.81" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                            <constraints><constraint firstAttribute="height" constant="4" id="route-height"/><constraint firstAttribute="width" constant="160" id="route-width"/></constraints>
                        </view>
                    </subviews>
                </stackView>
            </subviews>
            <viewLayoutGuide key="safeArea" id="safe-area"/>
            <color key="backgroundColor" red="0.06" green="0.15" blue="0.21" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
            <constraints><constraint firstItem="brand-stack" firstAttribute="centerX" secondItem="safe-area" secondAttribute="centerX" id="brand-center-x"/><constraint firstItem="brand-stack" firstAttribute="centerY" secondItem="safe-area" secondAttribute="centerY" id="brand-center-y"/></constraints>
        </view></viewController>
        <placeholder placeholderIdentifier="IBFirstResponder" id="first-responder" sceneMemberID="firstResponder"/>
    </objects></scene></scenes>
    <resources><image name="car.side.fill" catalog="system" width="128" height="75"/></resources>
